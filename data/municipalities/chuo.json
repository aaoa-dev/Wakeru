  "plasticTest": {
    "maxCm": null,
    "products": false,
    "summary": "Only clean plastic packaging with the プラマーク goes to Plastic. Plastic products without the mark (hangers, CDs, toys, cutlery, wrap) and any dirty packaging go to Burnable, and plastic items over 30 cm are oversized.",
    "bin": "pla",
    "otherwise": "burn"
  },
  "sorting": {
    "food": {
      "bin": "burn",
      "note": "Drain well first."
    },
    "hygiene": {
      "bin": "burn",
      "note": "Flush any waste from diapers down the toilet first."
    },
    "wood": {
      "bin": "burn",
      "note": "Small amounts under 50 cm. Larger amounts or longer pieces are oversized."
    },
    "textile": {
      "bin": "burn",
      "note": "Better: wash and take to a ward drop-off point (拠点回収: elementary schools every Saturday, or Recycle House Kazaguruma). Burnable only if you can't, or if badly soiled."
    },
    "leather-rubber": {
      "bin": "burn",
      "note": "Remove metal parts. If you can't, it goes to non-burnable."
    },
    "paper-dirty": {
      "bin": "burn",
      "note": "Includes receipts, photos, stickers, shredded paper, greasy pizza boxes and scented paper."
    },
    "paper-misc": {
      "bin": "res",
      "note": "As 雑紙: put in a paper bag so it doesn't scatter. Remove plastic windows and film."
    },
    "newspaper": {
      "bin": "res",
      "note": "Tie with string, or use the ward's newspaper bag. Flyers go with it."
    },
    "magazine": {
      "bin": "res",
      "note": "Tie with string. Books and clean notebooks count."
    },
    "cardboard": {
      "bin": "res",
      "note": "Fold flat and tie with string."
    },
    "carton": {
      "bin": "burn",
      "note": "Not collected curbside as a recyclable. Rinse, cut open and dry clean white-lined cartons of 500 ml or more and take them to a ward drop-off box (拠点回収). Dirty, silver-lined or small cartons go to burnable."
    },
    "pet": {
      "bin": "res",
      "note": "Cap and label off (they go to Plastic), rinse, flatten, into a see-through bag. Dirty or oily ones go to burnable."
    },
    "can": {
      "bin": "res",
      "note": "Rinse and put straight into the blue container. Badly soiled cans and 18 L cans go to non-burnable."
    },
    "bottle": {
      "bin": "res",
      "note": "Rinse and put straight into the yellow container. Clear, clean cosmetic bottles count. Broken, dirty or milky-white glass goes to non-burnable."
    },
    "glass-other": {
      "bin": "non",
      "note": "Wrap broken glass and ceramics in newspaper and write 危険."
    },
    "metal": {
      "bin": "non",
      "note": "Umbrellas, foil, metal hangers and pocket warmers. Exception: metal pots, pans and kettles up to 30 cm across (handle not counted) go to Recyclables, and larger ones are oversized."
    },
    "blade": {
      "bin": "non",
      "note": "Wrap the blade in newspaper and write 危険."
    },
    "plastic-pack": {
      "bin": "pla",
      "note": "Only items with the プラマーク. Rinse or wipe clean, put in a see-through bag (not double-bagged), out by 8:00."
    },
    "plastic-product": {
      "bin": "burn",
      "note": "Chuo does not collect plastic products as plastic. Over 30 cm goes to oversized."
    },
    "plastic-dirty": "burn",
    "plastic-mixed": {
      "bin": "burn",
      "note": "Plastic tubes, tape and pumps are burnable. Metal tubes and metal-heavy items are non-burnable."
    },
    "foam-tray": {
      "bin": "pla",
      "note": "Clean food trays go with Plastic. Rinsed and dried foam food trays can also go to ward drop-off boxes."
    },
    "battery": {
      "bin": "non",
      "note": "Better: ward drop-off points (public facilities, or schools on Saturdays). Otherwise non-burnable in a separate bag with the terminals taped."
    },
    "battery-li": {
      "bin": "non",
      "note": "Tape the terminals. Use a ward drop-off point or JBRC store box first, otherwise non-burnable in its own bag. Swollen batteries go by hand to the Chuo Cleaning Office counter (2F). Devices with built-in batteries (power banks, phones) go to small-appliance drop-off."
    },
    "spray": {
      "bin": "res",
      "note": "Use it up completely, don't punch holes, and put it in a semi-transparent bag on recyclables day."
    },
    "lighter": {
      "bin": "non",
      "note": "Use it up and make sure it won't light."
    },
    "fluorescent": {
      "bin": "non",
      "note": "Better: unbroken tubes to Saturday school drop-off. Otherwise in the original case or newspaper, marked 危険, bagged separately. Mercury thermometers are drop-off only."
    },
    "appliance-small": {
      "bin": "non",
      "note": "Better: ward small-appliance boxes (slot 15 × 26 cm). Otherwise non-burnable up to 30 cm, oversized above that."
    },
    "oil": {
      "bin": "burn",
      "note": "Solidify it first. Unsolidified cooking oil can go to Saturday school drop-off."
    },
    "oversized": {
      "bin": "big",
      "note": "Over about 30 cm on one side. Book with the Oversized Garbage Reception Center (03-6833-2525 or online), buy A (200 yen) or B (300 yen) tickets at a konbini, and put it at your entrance by 8:00 on the day."
    },
    "appliance-law": {
      "bin": "no",
      "note": "Return to the store, or call the Home Appliance Recycling Center (0570-087200)."
    },
    "pc": {
      "bin": "no",
      "note": "Use the manufacturer, PC3R (03-5282-7685) or Renet courier pickup. Small laptops and tablets that fit the 15 × 26 cm slot can go to ward small-appliance boxes. Wipe your data first."
    },
    "not-collected": {
      "bin": "no",
      "note": "Ask the maker or store. For extinguishers, contact the extinguisher recycling center (03-5829-6773)."
    }
  },
