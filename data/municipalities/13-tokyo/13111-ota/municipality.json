  "plasticTest": {
    "maxCm": 30,
    "products": true,
    "summary": "Clean plastic made only of plastic (no screws or rubber) and under 30 cm goes to Plastic, packaging and products together, including foam trays and PET caps and labels. Dirty plastic goes to Burnable, and plastic with lots of metal or batteries goes to Non-burnable.",
    "bin": "pla",
    "otherwise": "burn"
  },
  "sorting": {
    "food": {
      "bin": "burn",
      "note": "Drain off water first."
    },
    "hygiene": {
      "bin": "burn",
      "note": "Remove waste from diapers and close the bag."
    },
    "wood": {
      "bin": "burn",
      "note": "Branches: under 50 cm long and 10 cm thick, tied in bundles (max 3 bundles at a time)."
    },
    "textile": {
      "bin": "burn",
      "note": "Clean, wearable clothes can go to the ward's monthly used-clothing collection instead."
    },
    "leather-rubber": "burn",
    "paper-dirty": {
      "bin": "burn",
      "note": "Receipts, photos, paper cups, smelly or coated paper."
    },
    "paper-misc": {
      "bin": "res",
      "note": "Goes with magazines as 雑がみ, tied with string."
    },
    "newspaper": {
      "bin": "res",
      "note": "Fold, tie with string. Inserted flyers go with it."
    },
    "magazine": {
      "bin": "res",
      "note": "Tie with string. No clips or tape."
    },
    "cardboard": {
      "bin": "res",
      "note": "Remove tape and labels, fold flat, tie. No packing tape."
    },
    "carton": {
      "bin": "res",
      "note": "Rinse, cut open, dry and tie. Silver-lined cartons go to burnable."
    },
    "pet": {
      "bin": "res",
      "note": "Caps and labels off (they go to plastic), rinse, crush, in a see-through bag."
    },
    "can": {
      "bin": "res",
      "note": "Rinse, in a see-through bag. Snack and nori tins too."
    },
    "bottle": {
      "bin": "res",
      "note": "Cap off and rinse, in a see-through bag. Plastic caps to plastic, metal caps to non-burnable."
    },
    "glass-other": {
      "bin": "non",
      "note": "Wrap broken glass in thick paper and write 危険."
    },
    "metal": {
      "bin": "non",
      "note": "Umbrellas and frying pans count. About 30 cm or larger is oversized."
    },
    "blade": {
      "bin": "non",
      "note": "Wrap in a sturdy container or thick paper and write 危険."
    },
    "plastic-pack": {
      "bin": "pla",
      "note": "Empty and rinse, in a lidded container or see-through bag."
    },
    "plastic-product": {
      "bin": "pla",
      "note": "Only if 100% plastic (no screws or rubber) and under 30 cm."
    },
    "plastic-dirty": "burn",
    "plastic-mixed": {
      "bin": "non",
      "note": "Plastic with metal parts or batteries goes to non-burnable; check the ward app for other mixes."
    },
    "foam-tray": {
      "bin": "pla",
      "note": "Plastic day, not recyclables day."
    },
    "battery": {
      "bin": "non",
      "note": "Dry cells and coin cells (CR/BR) go to non-burnable. Button cells go to shop collection boxes."
    },
    "battery-li": {
      "bin": "no",
      "note": "Not ward trash. Use a JBRC partner shop, or the ward's 20 rechargeable-battery boxes; tape the terminals."
    },
    "spray": {
      "bin": "res",
      "note": "Use up, don't puncture. Separate see-through bag on recyclables day, apart from food cans."
    },
    "lighter": {
      "bin": "non",
      "note": "Use up, separate see-through bag on non-burnable day."
    },
    "fluorescent": {
      "bin": "non",
      "note": "In the original box, or wrap in thick paper and write 危険. Mercury thermometers: wrap, or take to the cleaning office."
    },
    "appliance-small": {
      "bin": "non",
      "note": "Under about 30 cm. Phones and cameras can go in the ward's small-appliance boxes (42 sites)."
    },
    "oil": {
      "bin": "burn",
      "note": "Solidify or soak into paper or cloth. Never liquid. Or recycle at ward offices (Wednesdays 11:00–15:00) or partner stores."
    },
    "oversized": {
      "bin": "big",
      "note": "Book with the Oversized Garbage Center (0570-037-530), buy a sticker at a supermarket or konbini, out by 8:00 on the day."
    },
    "appliance-law": {
      "bin": "no",
      "note": "Recycling law: ask the shop, or the Home Appliance Recycling Center (0570-087-200)."
    },
    "pc": {
      "bin": "no",
      "note": "Return to the maker (PC3R) or use ReNet's free pickup box."
    },
    "not-collected": {
      "bin": "no",
      "note": "Ask the shop or a specialist."
    }
  },
