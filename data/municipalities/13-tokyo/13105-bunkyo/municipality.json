  "plasticTest": {
    "maxCm": 30,
    "products": true,
    "summary": "Clean plastic packaging (プラマーク) and products made entirely of plastic and under 30 cm go to Plastic, on its own weekly day. Plastic that stays dirty after a light rinse goes to Burnable, and plastic joined with other materials goes to Burnable or Non-burnable depending on the main material.",
    "bin": "pla",
    "otherwise": "burn"
  },
  "sorting": {
    "food": {
      "bin": "burn",
      "note": "Drain off the water first."
    },
    "hygiene": {
      "bin": "burn",
      "note": "Remove waste from diapers."
    },
    "wood": {
      "bin": "burn",
      "note": "Cut branches to 30 cm or less and bag them. 5 or more bags count as a paid special pickup."
    },
    "textile": {
      "bin": "burn",
      "note": "Reusable clothes are better taken to a ward drop-off box. Dirty items: cut small and put in Burnable."
    },
    "leather-rubber": {
      "bin": "burn",
      "note": "Usable shoes and bags can go to a ward drop-off box instead."
    },
    "paper-dirty": "burn",
    "paper-misc": {
      "bin": "res",
      "note": "As 雑がみ: tuck inside a magazine or tie with string. Open boxes flat and peel off film."
    },
    "newspaper": {
      "bin": "res",
      "note": "Tie with string. Flyers can go with the newspaper."
    },
    "magazine": {
      "bin": "res",
      "note": "Tie with string."
    },
    "cardboard": {
      "bin": "res",
      "note": "Tie with string, about 10 sheets at a time at most."
    },
    "carton": {
      "bin": "burn",
      "note": "Not picked up with recyclables. Cartons of 500 ml or more are best washed, cut open and taken to a ward drop-off box. Silver-lined cartons always go to Burnable."
    },
    "pet": {
      "bin": "res",
      "note": "Cap and label off (they go to Plastic), rinse, crush, into the green container or net."
    },
    "can": {
      "bin": "res",
      "note": "Rinse, into the blue container. Snack and seaweed tins count too. Oily cans go to Non-burnable."
    },
    "bottle": {
      "bin": "res",
      "note": "Lid off, rinse, into the yellow container. Metal lids go to Non-burnable, plastic lids to Plastic."
    },
    "glass-other": {
      "bin": "non",
      "note": "Wrap broken glass and ceramics in newspaper and write キケン. Water-based cosmetic bottles and drink/tablet medicine bottles are recyclable (yellow container)."
    },
    "metal": {
      "bin": "non",
      "note": "Items about 30 cm or larger (pots measured without the handle) are Oversized. Umbrellas: up to 9 at a time in Non-burnable, tied together."
    },
    "blade": {
      "bin": "non",
      "note": "Wrap in newspaper and write キケン."
    },
    "plastic-pack": {
      "bin": "pla",
      "note": "Lightly rinse. Put directly into one clear or semi-clear bag (don't double-bag), out by 8:00."
    },
    "plastic-product": {
      "bin": "pla",
      "note": "Only if made entirely of plastic and under 30 cm on every side."
    },
    "plastic-dirty": "burn",
    "plastic-mixed": {
      "bin": "burn",
      "note": "If it's mostly metal, Non-burnable. Plastic tubes (toothpaste etc.) can go to Plastic if rinsed clean."
    },
    "foam-tray": {
      "bin": "pla",
      "note": "With the rest of the plastic. The old store/drop-off tray collection has ended."
    },
    "battery": {
      "bin": "non",
      "note": "Separate clear or semi-clear bag next to the Non-burnable bag, or a ward drop-off box. Button cells go to store collection boxes."
    },
    "battery-li": {
      "bin": "non",
      "note": "Since Oct 2026: tape over the terminals, put in a separate clear bag marked 充電式電池, out on Non-burnable day. Never in Plastic or Burnable. Take swollen or damaged ones to a ward counter."
    },
    "spray": {
      "bin": "res",
      "note": "Use up, don't punch holes, take off cap and nozzle (Plastic), put in a clear bag and place in the blue can container. If not empty: separate bag marked キケン on Non-burnable day."
    },
    "lighter": {
      "bin": "non",
      "note": "Use up. Separate see-through bag marked キケン, or hand it to the collection crew if it isn't empty."
    },
    "fluorescent": {
      "bin": "non",
      "note": "Ward drop-off box preferred. Otherwise in the original box or wrapped in paper, kept apart from the Non-burnable bag. Write キケン if broken. Mercury thermometers: separate see-through bag, or the Recycling Section counter."
    },
    "appliance-small": {
      "bin": "non",
      "note": "Remove batteries first. If the battery can't be removed, take it to a ward counter. 30 cm or larger is Oversized."
    },
    "oil": {
      "bin": "burn",
      "note": "Soak into old paper or cloth, or solidify. The ward also collects it at events."
    },
    "oversized": {
      "bin": "big",
      "note": "Book with the Oversized Garbage Center (03-5296-7000, Mon–Sat 8:00–19:00, or online), buy A (200 yen) / B (300 yen) stickers at a shop marked 有料粗大ごみ処理券取扱所, out by 8:00 at the agreed spot."
    },
    "appliance-law": {
      "bin": "no",
      "note": "Ask the shop you bought it from, or the Home Appliance Recycling Center."
    },
    "pc": {
      "bin": "no",
      "note": "Use the maker's take-back or ReNet Japan's courier pickup (free when a PC is in the box)."
    },
    "not-collected": {
      "bin": "no",
      "note": "Use a specialist disposal company or ask the shop. Small amounts of paint can be soaked up or solidified and put in Burnable."
    }
  },
