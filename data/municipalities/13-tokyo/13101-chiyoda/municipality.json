  "plasticTest": {
    "maxCm": 30,
    "products": true,
    "summary": "Clean, empty, 100% plastic and under 30 cm goes to Plastic, packaging and plastic products together. Anything dirty or mixed goes to Burnable.",
    "bin": "pla",
    "otherwise": "burn"
  },
  "sorting": {
    "food": {
      "bin": "burn",
      "note": "Drain off as much water as possible."
    },
    "hygiene": {
      "bin": "burn",
      "note": "Remove waste from diapers first."
    },
    "wood": {
      "bin": "burn",
      "note": "Cut branches to 50 cm or less, under 10 cm thick. Wrap skewers in paper."
    },
    "textile": {
      "bin": "burn",
      "note": "Cut curtains and sheets to 50 cm or less. Washed clothes can also go uncut to a ward stockyard."
    },
    "leather-rubber": {
      "bin": "burn",
      "note": "Remove metal parts if you can (they go to non-burnable). Cut rubber hoses to 50 cm."
    },
    "paper-dirty": "burn",
    "paper-misc": {
      "bin": "res",
      "note": "As その他の紙類: in its own bag, top tied, on recycling day. Powdery shredded paper goes to burnable."
    },
    "newspaper": {
      "bin": "res",
      "note": "Tie with string, no tape. Flyers go with the newspaper."
    },
    "magazine": {
      "bin": "res",
      "note": "Tie with string. Pamphlets go with magazines."
    },
    "cardboard": {
      "bin": "res",
      "note": "Fold flat and tie with string, no tape. Glossy waterproofed cardboard goes to burnable."
    },
    "carton": {
      "bin": "res",
      "note": "500 ml or larger with a white inside only: rinse, cut open, dry, tie. Smaller or silver-lined cartons go to burnable."
    },
    "pet": {
      "bin": "res",
      "note": "Cap and label off (they go to plastic), rinse, crush, into the net at the collection point."
    },
    "can": {
      "bin": "res",
      "note": "Food and drink cans only, snack tins count. Empty, rinse, into the can box. Tabs and lids go to non-burnable."
    },
    "bottle": {
      "bin": "res",
      "note": "Food and drink bottles only. Empty, rinse, into the bottle box. Metal caps go to non-burnable."
    },
    "glass-other": {
      "bin": "non",
      "note": "Broken glass and ceramics: wrap in thick paper, separate bag, write キケン. Wash out cosmetic bottles."
    },
    "metal": {
      "bin": "non",
      "note": "Umbrellas and 18 L cans count even if over 30 cm. Pots whose body (without handle) is over 30 cm are oversized."
    },
    "blade": {
      "bin": "non",
      "note": "Wrap in thick paper, separate bag, write キケン."
    },
    "plastic-pack": {
      "bin": "pla",
      "note": "Rinse off food, clear or semi-clear bag, out by 8:30."
    },
    "plastic-product": {
      "bin": "pla",
      "note": "Only if 100% plastic and under 30 cm. Larger items like storage cases are oversized."
    },
    "plastic-dirty": "burn",
    "plastic-mixed": {
      "bin": "burn",
      "note": "Includes pump tops, tubes you can't empty, video tapes and PP bands (cut to 30 cm)."
    },
    "foam-tray": {
      "bin": "pla",
      "note": "With the rest of the plastic. Rinse trays lightly."
    },
    "battery": {
      "bin": "haz",
      "note": "Bag separately and write キケン. Never with regular non-burnable or plastic."
    },
    "battery-li": {
      "bin": "haz",
      "note": "Bag separately and write キケン. Call the cleaning office first if it is damaged or swollen."
    },
    "spray": {
      "bin": "haz",
      "note": "Use up first. Don't punch holes. Separate bag marked キケン."
    },
    "lighter": {
      "bin": "haz",
      "note": "Use up the gas. Separate bag marked キケン."
    },
    "fluorescent": {
      "bin": "haz",
      "note": "In the original box or wrapped in newspaper. LED bulbs go to non-burnable."
    },
    "appliance-small": {
      "bin": "non",
      "note": "Take batteries out (they go to hazardous). Or use the ward's small-appliance drop boxes (slot 30×15 cm)."
    },
    "oil": {
      "bin": "burn",
      "note": "Solidified or soaked into paper. Or bring it in a bottle to a ward stockyard."
    },
    "oversized": {
      "bin": "big",
      "note": "Book with the Oversized Garbage Center (03-6743-0603 or online), buy a Chiyoda sticker at a shop or konbini, out by 8:30 on the day."
    },
    "appliance-law": {
      "bin": "no",
      "note": "Ask the shop you bought it from or the Home Appliance Recycling Center (0570-087200)."
    },
    "pc": {
      "bin": "no",
      "note": "Through the maker, PC3R (03-5282-7685) or ReNet Japan."
    },
    "not-collected": "no"
  },
