  "plasticTest": {
    "maxCm": 30,
    "products": true,
    "summary": "Clean plastic packaging and items made only of plastic, 30 cm or smaller, go to Plastic together. Plastic that won't rinse clean, or that has other materials attached, goes to Burnable, or to Ceramics, glass & metal if it is mostly metal or battery-powered.",
    "bin": "pla",
    "otherwise": "burn"
  },
  "sorting": {
    "food": {
      "bin": "burn",
      "note": "Drain the water well."
    },
    "hygiene": {
      "bin": "burn",
      "note": "Empty waste from diapers into the toilet first. Plastic-only sponges can go to Plastic."
    },
    "wood": {
      "bin": "burn",
      "note": "Cut branches to 50 cm or less. Five or more 45 L bags at once is a paid pickup: call the Cleaning Office first."
    },
    "textile": {
      "bin": "paper",
      "note": "Clean, washed clothes go to community collection in a clear bag, never on rainy days. Dirty or torn fabric goes to burnable."
    },
    "leather-rubber": {
      "bin": "burn",
      "note": "Over 30 cm on any side is oversized."
    },
    "paper-dirty": {
      "bin": "burn",
      "note": "Includes receipts, photos, pizza boxes, soap wrappers and paper egg cartons."
    },
    "paper-misc": {
      "bin": "paper",
      "note": "As 雑がみ: can go in a paper bag. Flatten boxes and remove any plastic window."
    },
    "newspaper": {
      "bin": "paper",
      "note": "Tie with string. Flyers go with the newspaper."
    },
    "magazine": {
      "bin": "paper",
      "note": "Tie with string."
    },
    "cardboard": {
      "bin": "paper",
      "note": "Fold flat, remove packing tape, tie."
    },
    "carton": {
      "bin": "paper",
      "note": "Rinse, cut open, dry, tie. 500 ml cartons are OK. Foil-lined cartons go to burnable."
    },
    "pet": {
      "bin": "res",
      "note": "Cap and label off (they go to Plastic), rinse, crush, straight into the net. Coloured or dirty PET goes to burnable."
    },
    "can": {
      "bin": "res",
      "note": "Rinse, into the blue crate. Pet-food cans count too. Non-food cans go to ceramics, glass & metal."
    },
    "bottle": {
      "bin": "res",
      "note": "Rinse, into the yellow crate. Metal caps go to ceramics, glass & metal; plastic caps go to Plastic."
    },
    "glass-other": {
      "bin": "non",
      "note": "Includes medicine and cosmetic bottles. Wrap broken pieces in paper, bag them separately and label the contents."
    },
    "metal": {
      "bin": "non",
      "note": "Umbrellas count even if over 30 cm. Other items over 30 cm are oversized."
    },
    "blade": {
      "bin": "non",
      "note": "Wrap safely, bag separately and label the contents."
    },
    "plastic-pack": {
      "bin": "pla",
      "note": "Empty and rinse. Price stickers can stay on. One clear or semi-clear bag, by 8:00."
    },
    "plastic-product": {
      "bin": "pla",
      "note": "Only if 100% plastic and 30 cm or smaller (since April 2024)."
    },
    "plastic-dirty": {
      "bin": "burn",
      "note": "If a quick rinse makes it clean, it can go to Plastic."
    },
    "plastic-mixed": {
      "bin": "burn",
      "note": "Mostly metal or battery-powered goes to ceramics, glass & metal. Take it apart to plastic-only and it can go to Plastic."
    },
    "foam-tray": {
      "bin": "pla",
      "note": "Rinse first. Goes with the rest of the plastic."
    },
    "battery": {
      "bin": "non",
      "note": "Best: the drop boxes at ward facilities. Otherwise put them out on ceramics, glass & metal day."
    },
    "battery-li": {
      "bin": "non",
      "note": "Since April 2026: separate bag labelled リチウムイオン電池, terminals taped. Swollen ones go to the Cleaning Office. Never with burnable or plastic."
    },
    "spray": {
      "bin": "non",
      "note": "Use it up, don't punch holes, separate bag labelled with the contents."
    },
    "lighter": {
      "bin": "non",
      "note": "Use it up, separate bag labelled with the contents."
    },
    "fluorescent": {
      "bin": "non",
      "note": "Best: the fluorescent-tube boxes at ward facilities. Otherwise put them out on ceramics, glass & metal day in their case. Mercury thermometers: separate labelled bag."
    },
    "appliance-small": {
      "bin": "non",
      "note": "30 cm or smaller. Phones and 8 other small devices: use the ward drop boxes. Over 30 cm is oversized."
    },
    "oil": {
      "bin": "burn",
      "note": "Soak it into cloth or paper, or use a solidifier. Some ward offices also take it bottled."
    },
    "oversized": {
      "bin": "big",
      "note": "Over 30 cm on any side. Book with the Oversized Garbage Center (03-5715-2255, Mon–Sat 8:00–19:00, or online), buy A (200 yen) or B (300 yen) stickers, out by 8:00 on the day."
    },
    "appliance-law": {
      "bin": "no",
      "note": "Recycled by the maker under the appliance recycling law (TV, fridge, washer, dryer, air conditioner)."
    },
    "pc": {
      "bin": "no",
      "note": "Use the Renet Japan courier pickup (free for one box with a PC) or the manufacturer."
    },
    "not-collected": {
      "bin": "no",
      "note": "Ask the shop, the manufacturer or a specialist. The ward page lists fire-extinguisher contractors."
    }
  },
