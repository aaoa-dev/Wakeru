  "plasticTest": {
    "maxCm": 30,
    "products": true,
    "summary": "Clean plastic packaging and items made 100% of plastic up to about 30 cm go to Plastic together; foam trays and styrofoam go to Recyclables instead, and anything dirty or mixed goes to Burnable."
  },
  "sorting": {
    "food": {
      "bin": "burn",
      "note": "Drain well. Eggshells too."
    },
    "hygiene": {
      "bin": "burn",
      "note": "Remove waste from diapers first."
    },
    "wood": {
      "bin": "burn",
      "note": "Cut branches to about 30 cm and tie in bundles. Larger wood is oversized."
    },
    "textile": {
      "bin": "burn",
      "note": "Remove metal parts if you can. Used clothes are also taken at ward drop-off points."
    },
    "leather-rubber": {
      "bin": "burn",
      "note": "Remove metal parts if you can. About 30 cm or larger is oversized."
    },
    "paper-dirty": {
      "bin": "burn",
      "note": "Thermal receipts, photos, waxed or oily paper, paper cups, window envelopes."
    },
    "paper-misc": {
      "bin": "res",
      "note": "As 雑がみ: tie with string or put in a paper bag on recycling day."
    },
    "newspaper": {
      "bin": "res",
      "note": "Tie with string. Flyers go with the newspaper."
    },
    "magazine": {
      "bin": "res",
      "note": "Tie with string."
    },
    "cardboard": {
      "bin": "res",
      "note": "Fold flat and tie with string."
    },
    "carton": {
      "bin": "res",
      "note": "Rinse, open flat, tie or put in a paper bag with the paper. Foil-lined cartons go to burnable."
    },
    "pet": {
      "bin": "res",
      "note": "Cap and label off (they go to plastic), rinse, crush, into the green container."
    },
    "can": {
      "bin": "res",
      "note": "Rinse and lightly crush, into the blue container. Oily cans (tuna, pet food, cooking oil) go to non-burnable."
    },
    "bottle": {
      "bin": "res",
      "note": "Rinse, into the yellow container. Metal caps go to non-burnable. Oily or broken bottles go to non-burnable."
    },
    "glass-other": {
      "bin": "non",
      "note": "Wrap broken glass and ceramics in thick paper and write キケン."
    },
    "metal": {
      "bin": "non",
      "note": "About 30 cm or larger (e.g. big pots) is oversized."
    },
    "blade": {
      "bin": "non",
      "note": "Wrap in paper and write キケン."
    },
    "plastic-pack": {
      "bin": "pla",
      "note": "Rinse or wipe, in a see-through bag (no bag inside a bag) or lidded bin. Out by 8:00."
    },
    "plastic-product": {
      "bin": "pla",
      "note": "Only if 100% plastic and within about 30 cm."
    },
    "plastic-dirty": "burn",
    "plastic-mixed": {
      "bin": "burn",
      "note": "Mixed-material items like marker pens and silicone go to burnable; lighters and razors go to non-burnable."
    },
    "foam-tray": {
      "bin": "res",
      "note": "Koto collects foam trays and styrofoam on recycling day (grey lidded container), not with plastic, even if they carry the plastic mark. Dirty ones go to burnable."
    },
    "battery": {
      "bin": "non",
      "note": "Non-burnable day, in its own clear bag (batteries, fluorescent tubes and mercury items together), separate from other non-burnable."
    },
    "battery-li": {
      "bin": "non",
      "note": "Non-burnable day in the battery bag. Tape the terminals. Swollen batteries: bag alone and write 膨張電池. Can also be taken to the Cleaning Office or a JBRC box."
    },
    "spray": {
      "bin": "non",
      "note": "Use up, don't punch holes. Put spray cans, gas canisters and lighters together in their own bag on non-burnable day."
    },
    "lighter": {
      "bin": "non",
      "note": "Use up. Same bag as spray cans on non-burnable day."
    },
    "fluorescent": {
      "bin": "non",
      "note": "Unbroken: in the original paper case or thick paper, in the battery/mercury bag. Broken: regular non-burnable, marked キケン."
    },
    "appliance-small": {
      "bin": "non",
      "note": "Remove batteries. Items with a built-in rechargeable battery go in the battery bag. Under 15×25 cm can go in ward drop boxes. About 30 cm or larger is oversized."
    },
    "oil": {
      "bin": "burn",
      "note": "Soak into paper or cloth, or solidify it."
    },
    "oversized": {
      "bin": "big",
      "note": "Book with the Oversized Garbage Reception Center (03-6431-9997 or online), buy a sticker, out by 8:00 on the day."
    },
    "appliance-law": {
      "bin": "no",
      "note": "Ask the shop, or the Home Appliance Recycling Center (0570-087200)."
    },
    "pc": {
      "bin": "no",
      "note": "Maker take-back or ReNet Japan (0570-085-800)."
    },
    "not-collected": {
      "bin": "no",
      "note": "Use a specialist or the maker's take-back."
    }
  },
