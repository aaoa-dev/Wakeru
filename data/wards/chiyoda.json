  "plasticTest": {
    "maxCm": 30,
    "products": true,
    "summary": "Clean, empty, 100% plastic and under 30 cm goes to Plastic, packaging and plastic products together. Anything dirty or mixed goes to Burnable."
  },
  "sorting": {
    "food": "burn",
    "hygiene": "burn",
    "wood": "burn",
    "textile": {
      "bin": "burn",
      "note": "Washed clothes can also go to a ward stockyard."
    },
    "leather-rubber": {
      "bin": "burn",
      "note": "Remove metal parts if you can (they go to non-burnable)."
    },
    "paper-dirty": "burn",
    "paper-misc": {
      "bin": "res",
      "note": "As その他の紙類: in a separate paper bag or tied bag on recycling day."
    },
    "newspaper": {
      "bin": "res",
      "note": "Tie with string. Flyers go with the newspaper."
    },
    "magazine": {
      "bin": "res",
      "note": "Tie with string."
    },
    "cardboard": {
      "bin": "res",
      "note": "Fold flat and tie. No packing tape bundles."
    },
    "carton": {
      "bin": "res",
      "note": "500 ml or larger only. Smaller cartons go to burnable."
    },
    "pet": {
      "bin": "res",
      "note": "Cap and label off, rinse, crush, into the green net."
    },
    "can": {
      "bin": "res",
      "note": "Into the blue box. Snack cans count too."
    },
    "bottle": {
      "bin": "res",
      "note": "Into the yellow box. Metal caps go to non-burnable."
    },
    "glass-other": {
      "bin": "non",
      "note": "Broken glass and ceramics: wrap in thick paper, separate bag, write キケン."
    },
    "metal": {
      "bin": "non",
      "note": "Umbrellas count even if over 30 cm. Pots over 30 cm (without handle) are oversized."
    },
    "blade": {
      "bin": "non",
      "note": "Wrap in thick paper, separate bag, write キケン."
    },
    "plastic-pack": {
      "bin": "pla",
      "note": "Clear or semi-clear bag, out by 8:30."
    },
    "plastic-product": {
      "bin": "pla",
      "note": "Only if 100% plastic and under 30 cm."
    },
    "plastic-dirty": "burn",
    "plastic-mixed": "burn",
    "foam-tray": {
      "bin": "pla",
      "note": "With the rest of the plastic."
    },
    "battery": {
      "bin": "haz",
      "note": "Bag separately and write キケン. Never with regular non-burnable."
    },
    "battery-li": {
      "bin": "haz",
      "note": "Bag separately and write キケン."
    },
    "spray": {
      "bin": "haz",
      "note": "Don't punch holes. Separate bag marked キケン."
    },
    "lighter": {
      "bin": "haz",
      "note": "Separate bag marked キケン."
    },
    "fluorescent": "haz",
    "appliance-small": {
      "bin": "non",
      "note": "Or the ward's small-appliance drop boxes."
    },
    "oil": {
      "bin": "burn",
      "note": "Solidified or soaked into paper. Or bring it in a bottle to a ward stockyard."
    },
    "oversized": {
      "bin": "big",
      "note": "Book with the Oversized Garbage Center (03-6743-0603), buy a sticker at a konbini, out by 8:30 on the day."
    },
    "appliance-law": "no",
    "pc": "no",
    "not-collected": "no"
  },
